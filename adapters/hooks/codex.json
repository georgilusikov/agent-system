{
  "description": "Shared Codex lifecycle hooks: status reporting and non-blocking continuity after compaction.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s\\n' '{\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":\"Context was compacted. Re-read the retained objective, decisions, completed checks, and next action, then continue the same task. Never stop or start a fresh task solely because of compaction.\"}}'",
            "timeout": 1,
            "statusMessage": "Restoring task continuity"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash '/Users/georgijlusikov/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x '/Users/georgijlusikov/.nodeterm/agent-hooks/codex.sh' ]; then /bin/sh '/Users/georgijlusikov/.nodeterm/agent-hooks/codex.sh'; fi"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "sh '/Users/georgijlusikov/.codex/hooks/response-contract-reminder.sh'",
            "timeout": 1,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x '/Users/georgijlusikov/.nodeterm/agent-hooks/codex.sh' ]; then /bin/sh '/Users/georgijlusikov/.nodeterm/agent-hooks/codex.sh'; fi"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x '/Users/georgijlusikov/.nodeterm/agent-hooks/codex.sh' ]; then /bin/sh '/Users/georgijlusikov/.nodeterm/agent-hooks/codex.sh'; fi"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x '/Users/georgijlusikov/.nodeterm/agent-hooks/codex.sh' ]; then /bin/sh '/Users/georgijlusikov/.nodeterm/agent-hooks/codex.sh'; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x '/Users/georgijlusikov/.nodeterm/agent-hooks/codex.sh' ]; then /bin/sh '/Users/georgijlusikov/.nodeterm/agent-hooks/codex.sh'; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x '/Users/georgijlusikov/.nodeterm/agent-hooks/codex.sh' ]; then /bin/sh '/Users/georgijlusikov/.nodeterm/agent-hooks/codex.sh'; fi"
          }
        ]
      }
    ]
  }
}
