{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/georgijlusikov/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "dippy"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/georgijlusikov/.claude/hooks/git_worktree_completeness_gate.py",
            "timeout": 40
          },
          {
            "type": "command",
            "command": "python3 /Users/georgijlusikov/.claude/hooks/untracked_critical_files_gate.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 /Users/georgijlusikov/.claude/hooks/worktree_isolation_gate.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/georgijlusikov/.claude/hooks/banned_doc_names_gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -r '/Users/georgijlusikov/.nodeterm/agent-hooks/claude.sh' ]; then sh '/Users/georgijlusikov/.nodeterm/agent-hooks/claude.sh'; else cat >/dev/null 2>&1 || :; fi"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -r '/Users/georgijlusikov/.nodeterm/agent-hooks/claude.sh' ]; then sh '/Users/georgijlusikov/.nodeterm/agent-hooks/claude.sh'; else cat >/dev/null 2>&1 || :; fi"
          }
        ]
      }
    ],
    "SessionStart": [
