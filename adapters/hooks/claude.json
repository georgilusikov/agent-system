            "command": "if [ -r '/Users/georgijlusikov/.nodeterm/agent-hooks/claude.sh' ]; then sh '/Users/georgijlusikov/.nodeterm/agent-hooks/claude.sh'; else cat >/dev/null 2>&1 || :; fi"
          }
