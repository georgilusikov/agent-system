        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/georgijlusikov/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "command -v bd >/dev/null 2>&1 && bd prime --hook-json || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 /Users/georgijlusikov/.claude/hooks/session_start_handoff.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash '/Users/georgijlusikov/.claude/hooks/session-start-memory.sh'",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -r '/Users/georgijlusikov/.nodeterm/agent-hooks/claude.sh' ]; then sh '/Users/georgijlusikov/.nodeterm/agent-hooks/claude.sh'; else cat >/dev/null 2>&1 || :; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/gemini-audit.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-python-checks.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/incident-parking.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -r '/Users/georgijlusikov/.nodeterm/agent-hooks/claude.sh' ]; then sh '/Users/georgijlusikov/.nodeterm/agent-hooks/claude.sh'; else cat >/dev/null 2>&1 || :; fi"
